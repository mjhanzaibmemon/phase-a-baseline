#cloud-config
# First boot only. Everything here runs once and cannot be corrected later without
# rebuilding, so it stays small on purpose: get the box to the point where Ansible
# can connect safely, then stop.
#
# No secrets go in here. User data is readable from provider metadata, so the
# Tailscale auth key, restic password and anything else sensitive arrive later
# through Ansible, not through this file.

hostname: ${hostname}
preserve_hostname: false

users:
  - name: ${admin_username}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
packages:
  - python3
  - python3-apt
  - sudo

write_files:
  - path: /etc/ssh/sshd_config.d/00-cloud-init-hardening.conf
    permissions: "0644"
    content: |
      # Minimal first boot posture. The baseline role replaces this with the full
      # drop-in once Ansible runs, but the box should never sit here with password
      # auth enabled while it waits.
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no

  - path: /etc/baseline-bootstrap
    permissions: "0444"
    content: |
      bootstrapped_by=cloud-init
      managed_by=ansible

runcmd:
  - [ systemctl, restart, ssh ]

final_message: "cloud-init finished in $UPTIME seconds. Ansible takes it from here."
